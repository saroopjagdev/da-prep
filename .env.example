# Required for AI features (mock interviews, feedback, STAR builder, statement review)
OPENAI_API_KEY=

# Optional model overrides.
# OPENAI_MODEL: marking and feedback (default gpt-6.1-sol)
# OPENAI_MODEL_FAST: interview questions and STAR drafts (default gpt-6-luna)
# OPENAI_TRANSCRIBE_MODEL: turns recorded video-style answers into text (default gpt-transcribe)
OPENAI_MODEL=
OPENAI_MODEL_FAST=
OPENAI_TRANSCRIBE_MODEL=

# Public URL of the deployed site (used for metadata, sitemap and robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development only: serve canned AI responses so the UI works without an API key.
# Ignored when NODE_ENV=production.
MOCK_AI=

# Optional: accounts + cloud sync (apply supabase/migrations/*.sql first)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Free-tier limits (needs Supabase above). In production they are ON automatically when Supabase is configured;
# set ENFORCE_LIMITS=false to switch them off, or true to force them on elsewhere. Then Stripe subscriptions:
ENFORCE_LIMITS=
STRIPE_SECRET_KEY=
# The one Pro price: a recurring GBP 9.99 per month price. Checkout checks it matches lib/plans.ts and refuses if not.
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Strongly recommended in production: a separate secret used to sign practice sessions. Any long random string.
# If empty it falls back to SUPABASE_SERVICE_ROLE_KEY, which should not double as a signing key.
PASS_SECRET=

# Recommended in production: shared rate limiting across serverless instances (free Upstash Redis database)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shown on the privacy notice and terms. Set before launch.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Show "Continue with Google" on the sign-in page. Only set to true after enabling the Google provider in Supabase.
NEXT_PUBLIC_GOOGLE_SIGNIN=

# Show "type the 8-digit code" on the sign-in forms. Only set to true after the Supabase email template includes {{ .Token }} (docs/next-steps.md).
NEXT_PUBLIC_EMAIL_CODE=

# LinkedIn daily post and comment replies (docs/linkedin.md). Everything is off until LINKEDIN_ENABLED is "true", and nothing
# is sent to LinkedIn until LINKEDIN_LIVE is "true" (before that, /api/social/linkedin/run only shows what it would do).
LINKEDIN_ENABLED=
LINKEDIN_LIVE=
# urn:li:person:... to post as yourself, or urn:li:organization:... for the Level6 page
LINKEDIN_AUTHOR_URN=
LINKEDIN_ACCESS_TOKEN=
# When the token stops working (ISO date, for example 2027-01-08): the job warns 10 days before and stops after.
LINKEDIN_TOKEN_EXPIRES=
# Needs a company page (urn:li:organization) with Community Management API access.
LINKEDIN_REPLIES_ENABLED=
# Optional: override the Linkedin-Version header (YYYYMM). Default 202610.
LINKEDIN_API_VERSION=

# The one-off Season Pass (GBP 39, Pro until 31 August 2027, no renewal). Off until BOTH are set: create a one-off GBP 39 price in Stripe
# (not recurring), put its id in STRIPE_PRICE_PASS, then set NEXT_PUBLIC_PASS_ENABLED=true. Apply the pro_until migration first.
STRIPE_PRICE_PASS=
NEXT_PUBLIC_PASS_ENABLED=
