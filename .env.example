# Required for AI features (mock interviews, feedback, STAR builder, statement review)
OPENAI_API_KEY=

# Optional model overrides.
# OPENAI_MODEL: marking and feedback (default gpt-6.1-sol)
# OPENAI_MODEL_FAST: interview questions and STAR drafts (default gpt-6-luna)
# OPENAI_TRANSCRIBE_MODEL: turns recorded video-style answers into text (default gpt-transcribe)
OPENAI_MODEL=
OPENAI_MODEL_FAST=
OPENAI_TRANSCRIBE_MODEL=

# Public URL of the deployed site (used for metadata, sitemap and robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development only: serve canned AI responses so the UI works without an API key.
# Ignored when NODE_ENV=production.
MOCK_AI=

# Optional: accounts + cloud sync (apply supabase/migrations/*.sql first)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Free-tier limits (needs Supabase above). In production they are ON automatically when Supabase is configured;
# set ENFORCE_LIMITS=false to switch them off, or true to force them on elsewhere. Then Stripe subscriptions:
ENFORCE_LIMITS=
STRIPE_SECRET_KEY=
# Two prices, matching lib/plans.ts: a recurring £17/month price and a one-off £30 price for the 3-month pass.
# (STRIPE_PRICE_ID is still read as the monthly price if STRIPE_PRICE_MONTHLY is empty.)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_PASS=
STRIPE_WEBHOOK_SECRET=

# Optional: secret used to sign practice passes (defaults to SUPABASE_SERVICE_ROLE_KEY). Any long random string.
PASS_SECRET=

# Recommended in production: shared rate limiting across serverless instances (free Upstash Redis database)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shown on the privacy notice and terms. Set before launch.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
